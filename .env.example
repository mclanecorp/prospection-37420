# Copier en .env et remplir. Aucune de ces valeurs ne doit être versionnée.

# Mot de passe partagé entre les membres du comité pour entrer dans l'app.
APP_PASSWORD=a-changer

# Clé de signature des cookies. Générer une valeur au hasard :
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=a-changer

# Adresse publique de l'app. Meta vient y télécharger les photos :
# elle doit être joignable depuis Internet et en https.
PUBLIC_BASE_URL=https://mon-app.example.fr

# App Meta : tableau de bord développeurs > Paramètres > Général.
META_APP_ID=
META_APP_SECRET=

# Fuseau horaire pour la programmation et l'affichage des dates.
TIMEZONE=Europe/Paris

# Mode simulation : 1 pour essayer l'app sans rien publier pour de vrai.
DRY_RUN=0
